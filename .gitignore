node_modules/
/build/
.env
.env.*
!.env.example
*.log
.DS_Store
.claude/

# Build outputs. Internal packages are consumed as TypeScript source, so these
# only appear once an app or a published package actually emits.
dist/
*.tsbuildinfo
coverage/

# Vite+ keeps its task cache in node_modules/.vite/task-cache, already covered above.

# copies de travail
*.bak

# Prototypes cliquables : ils vivent à la racine du projet, hors du dépôt.
# Le PRD y renvoie en ../../proto/ ; ils font autorité sur la mise en page,
# pas sur les règles, et ne méritent pas un historique.
proto/

# Les PRD vivent à la racine du projet, hors du dépôt, avec les prototypes.
docs/

# Matériel cryptographique de développement : l'autorité locale et le certificat
# que `scripts/dev-tls-cert.ts` fabrique pour que le téléphone atteigne le serveur
# en HTTPS sur le réseau de la maison (§16). Une clé privée ne se versionne pas, et
# celle-ci signe tout ce que ce PC prétend être.
/certs/

# journaux du launcher
.logs/
