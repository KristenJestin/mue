# Mue Platform — development environment.
#
# Copy to `.env` at the repository root and adjust. `.env` is git-ignored;
# `.env.example` is committed and must never hold a real secret.
#
#   cp .env.example .env
#
# Production never reuses this file: the shared PostgreSQL credentials are
# provisioned by the DBA (see infra/README.md) and injected by the deployment.

# --- Development PostgreSQL container (infra/compose.dev.yml) ---------------

# Image tag. PRD §20.3 pins PostgreSQL 18 as the only engine.
MUE_DB_IMAGE_TAG=18-alpine

# Host publication. Loopback only: no Mue service listens on a public
# interface unless it was configured to (PRD §22.5). 5433 keeps a PostgreSQL
# already installed on the host at 5432 untouched.
MUE_DB_BIND=127.0.0.1
MUE_DB_PORT=5433

# Named volume holding the cluster. `down` keeps it, `down -v` wipes it.
MUE_DB_VOLUME=mue-dev-pgdata

# Cluster owner, created by initdb. It stands in for the DBA of the shared
# production cluster and is used by nothing but the init scripts.
POSTGRES_USER=mue_owner
POSTGRES_PASSWORD=dev-only-owner-password-change-me
POSTGRES_DB=mue_dev

# The limited Mue role and its schemas. Production gets the exact same shape,
# created by hand by the DBA. The application only ever connects as this role.
MUE_DB_ROLE=mue
MUE_DB_PASSWORD=dev-only-mue-password-change-me
MUE_APP_SCHEMA=mue_app
MUE_AUTH_SCHEMA=mue_auth

# --- Platform ---------------------------------------------------------------

# The only database handle the application reads. It carries the limited role,
# never the owner. In production this points at the shared cluster instead.
DATABASE_URL=postgres://mue:dev-only-mue-password-change-me@127.0.0.1:5433/mue_dev

# --- Authentification (packages/auth) ---------------------------------------

# Secret maître, 32 caractères au minimum. Il chiffre notamment la clé privée
# JWKS en base : un serveur redémarré avec un autre secret ne sait plus la
# déchiffrer et l'authentification échoue sans message clair. En production il
# est injecté par le déploiement et n'apparaît dans aucun fichier.
#
#   openssl rand -base64 48
#
BETTER_AUTH_SECRET=dev-only-secret-at-least-32-characters-change-me

# Origine publique et émetteur OAuth. HTTPS obligatoire hors loopback (§16).
# Sert de base à `<base>/mcp` (la ressource protégée RFC 8707), à `/sign-in`
# et à `/consent`.
BETTER_AUTH_URL=http://127.0.0.1:3000

# Facultatifs, valeurs par défaut dérivées de BETTER_AUTH_URL :
# MUE_TRUSTED_ORIGINS=http://127.0.0.1:3000
# MUE_MCP_RESOURCE=http://127.0.0.1:3000/mcp
# MUE_LOGIN_PAGE=/sign-in
# MUE_CONSENT_PAGE=/consent
