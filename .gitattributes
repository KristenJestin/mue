* text=auto eol=lf

# The Gradle wrapper ships both entry points and both must keep working (section 22.6):
# gradlew.bat needs CRLF for cmd.exe, gradlew needs LF for POSIX sh.
*.bat text eol=crlf

*.jar binary
*.ttf binary
*.webp binary
*.png binary

