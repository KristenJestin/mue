# Configuration du déploiement sur le serveur personnel.
#
# Copie ce fichier en `.env` **à côté de `compose.yml`**, donc dans `mue/` et non dans le
# clone. Il n'est délibérément pas nommé `.env.…` : le `.gitignore` du dépôt ignore tout ce
# qui commence par `.env` sauf `.env.example`, et un fichier de configuration serveur qui
# disparaît silencieusement d'un `git add` est un fichier qu'on réécrit de mémoire six mois
# plus tard.
#
#     mue/
#       compose.yml
#       .env          <- ce fichier, renommé et rempli
#       app/
#
# `.env.example`, à la racine du dépôt, est l'autre fichier : celui du poste de
# développement, qui démarre un PostgreSQL de test. Ici la base est administrée à part, donc
# aucune variable `POSTGRES_*` ni `MUE_DB_*` n'apparaît — elles ne serviraient à rien.


# --- La base ------------------------------------------------------------------------------
#
# Le rôle, la base et les deux schémas sont créés une fois à la main, avant le premier
# démarrage : voir « Production — what the DBA must run » en bas de `app/infra/README.md`.
# Le déploiement ne crée ni base, ni rôle, ni schéma (PRD_SERVER_SYNC_MCP 20.3).
#
# L'hôte dépend de l'endroit où tourne PostgreSQL :
#
#   sur la machine, hors Docker   -> host.docker.internal   (le compose le rend résolvable)
#   dans un conteneur Docker      -> le nom du conteneur, avec un réseau partagé ;
#                                    voir la note en bas de compose.yml
#
DATABASE_URL=postgres://mue:REMPLACE_MOI@host.docker.internal:5432/mue


# --- L'authentification -------------------------------------------------------------------
#
# Au moins 32 caractères. Génère-le, ne l'invente pas :
#
#     openssl rand -base64 32
#
# Il chiffre la clé de signature JWKS stockée en base. Le changer rend illisibles les clés
# déjà chiffrées sous l'ancien : le téléphone se met alors à répondre 401 sans message clair
# nulle part. Si tu dois le changer, vide `mue_auth.jwks` dans la foulée.
BETTER_AUTH_SECRET=REMPLACE_MOI_32_CARACTERES_MINIMUM

# **L'adresse que le téléphone compose**, exactement : protocole, IP et port compris.
#
# C'est la variable qui se trompe en silence. Elle signe les cookies et construit les
# redirections d'authentification ; une valeur en `127.0.0.1` ou `localhost` produit un
# serveur qui répond parfaitement depuis lui-même et refuse d'appairer le téléphone, sans
# rien dire d'utile.
#
# En clair (`http://`) : seules les variantes Android `debug`, `beta` et `local` acceptent
# une adresse non chiffrée. `release` la refuse toujours par son nom.
BETTER_AUTH_URL=http://192.168.1.50:3000


# --- Le port publié -----------------------------------------------------------------------
#
# Le port côté hôte. Le conteneur écoute toujours sur 3000 en interne ; ne change celui-ci
# que s'il est déjà pris sur la machine — et alors répercute-le dans `BETTER_AUTH_URL` et
# dans l'adresse que tu tapes à l'appairage.
MUE_PLATFORM_PORT=3000


# --- TLS : à laisser vide -----------------------------------------------------------------
#
# Sans ces deux variables, le serveur écoute en clair. N'en poser qu'une **fait échouer le
# démarrage** plutôt que d'ouvrir un port en clair qui aurait l'air configuré — c'est
# volontaire, un serveur à moitié configuré est la panne qu'on ne voit pas de l'extérieur.
#
# Le jour où tu passes en HTTPS, ce sont des chemins **dans le conteneur** : il faut donc
# aussi monter les fichiers en volume dans `compose.yml`.
#
# MUE_TLS_CERT_FILE=/certs/fullchain.pem
# MUE_TLS_KEY_FILE=/certs/privkey.pem
