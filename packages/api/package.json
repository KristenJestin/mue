{
  "name": "@mue/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Hono routes and MCP transport",
  "exports": {
    ".": "./src/index.ts"
  },
  "types": "./src/index.ts",
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "lint": "vp lint src",
