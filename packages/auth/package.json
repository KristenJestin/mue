{
  "name": "@mue/auth",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Better Auth configuration and adapters",
  "exports": {
    ".": "./src/index.ts"
  },
  "types": "./src/index.ts",
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "lint": "vp lint src && vp -C ../.. lint scripts",
    "format": "vp fmt src && vp -C ../.. fmt scripts",
    "format:check": "vp fmt --check src && vp -C ../.. fmt --check scripts",
    "test": "bun --env-file=../../.env test"
  },
  "dependencies": {
    "@better-auth/cimd": "catalog:",
    "@better-auth/mcp": "catalog:",
    "@mue/db": "workspace:*",
    "better-auth": "catalog:",
    "drizzle-orm": "catalog:"
  }
}
