{
  "name": "@mue/contracts",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Shared HTTP schemas and the generated openapi.json",
  "exports": {
    ".": "./src/index.ts"
  },
  "types": "./src/index.ts",
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "lint": "vp lint src",
    "format": "vp fmt src",
    "format:check": "vp fmt --check src",
    "test": "bun test src",
    "openapi": "bun run ../../scripts/gen-openapi.ts",
    "openapi:check": "bun run ../../scripts/gen-openapi.ts --check",
    "fixtures": "bun run src/fixtures.ts"
  },
  "dependencies": {
    "zod": "catalog:"
  }
}
