{
  "name": "@mue/domain",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Server-side business services, the single implementation of every rule",
  "exports": {
    ".": "./src/index.ts"
  },
  "types": "./src/index.ts",
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "lint": "vp lint src",
    "format": "vp fmt src",
    "format:check": "vp fmt --check src",
    "test": "bun --env-file=../../.env test"
  },
  "dependencies": {
    "@mue/contracts": "workspace:*",
    "@mue/db": "workspace:*",
    "drizzle-orm": "catalog:"
  }
}
