<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!--
      Mue runs entirely offline. The absence of android.permission.INTERNET is a
      deliberate, verifiable guarantee that no measurement ever leaves the device.
      Do not add it.
    -->
    <uses-permission android:name="android.permission.VIBRATE" />

    <application
        android:name=".MueApplication"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Mue">

        <!--
          Portrait is a product decision, not an oversight: PRD 20.1 fixes the orientation and
          PRD 5 puts landscape and tablet outside the V1. The scale is a horizontal gesture
          sized against the screen width, so a landscape layout is a redesign, not a rotation.
        -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:screenOrientation="portrait"
            android:configChanges="uiMode|screenSize|smallestScreenSize|screenLayout|density|keyboardHidden|orientation"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/Theme.Mue"
            tools:ignore="DiscouragedApi,LockedOrientationActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Shares the generated CSV without exposing the app's private storage. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>

</manifest>
