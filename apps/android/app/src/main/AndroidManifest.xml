<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!--
      PRD_SERVER_SYNC_MCP 19 supersedes the offline-only guarantee this file used to state.
      Mue is still local-first — every write lands in Room first and the app is fully usable
      with no server — but it now synchronises with the owner's private server, so the network
      permission is required rather than forbidden. It is asked for at install time and grants
      access to nothing but the server the user paired with.

      PRD 20.4 and PRD_ACTIVITY_TIMER 17 still describe the old guarantee; PRD_SERVER_SYNC_MCP
      is the later authority and 19 also requires the privacy policy and the store listing to
      be updated, since neither may claim a total absence of network permission any more.
    -->
    <uses-permission android:name="android.permission.INTERNET" />

    <uses-permission android:name="android.permission.VIBRATE" />

    <!--
      The Activity Timer's ongoing notification (PRD_ACTIVITY_TIMER 6.5 and 17). Asked for at
      runtime on Android 13 and above, in the context of the first `Start timer`, and refused
      without consequence: the timer runs, pauses and finishes from inside Mue either way.
    -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!--
      Install-time only, with no runtime prompt. Android clears every notification at boot, so
      a timer restored from Room would come back invisible outside the app; this is what lets
      it be reposted. It does nothing at all when no timer is running or paused.
    -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!--
      The scale module (PRD_SCALE 16.1). Asked for at the first pairing and never at launch
      (FR-SCALE-025), in a context where the reason is obvious, and refused without consequence:
      BR-SCALE-011 keeps every function of Mue available with no Bluetooth and no permission
      granted, so nothing below may ever gate a weigh-in typed by hand.

      `neverForLocation` is a statement of fact rather than a shortcut around the location
      permission: PRD_SCALE 16.1 uses a scan result for exactly one thing, deciding whether a
      driver recognises a scale, and derives no position from it.

      `tools:targetApi` only silences lint, which points out that the flag was introduced in API
      31 while `minSdk` is 26. That is the intent: the whole permission is an API 31 one, older
      releases ignore both it and its flag, and the pre-31 pair below is what they read instead.
    -->
    <uses-permission
        android:name="android.permission.BLUETOOTH_SCAN"
        android:usesPermissionFlags="neverForLocation"
        tools:targetApi="s" />

    <!-- PRD_SCALE 16.1: opening the GATT link to the scale. Runtime, from Android 12. -->
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />

    <!--
      The pre-Android-12 half of the same pair, granted at install and never prompted for.
      `minSdk` is 26 (PRD 20.1), so the two regimes genuinely coexist on shipped devices and
      PRD_SCALE 16.1 requires them to be exercised separately: `BLUETOOTH` / `BLUETOOTH_ADMIN`
      up to API 30, `BLUETOOTH_SCAN` / `BLUETOOTH_CONNECT` from API 31. `maxSdkVersion` is what
      stops the historic pair from being requested — and shown in Settings — on a modern phone.
    -->
    <uses-permission
        android:name="android.permission.BLUETOOTH"
        android:maxSdkVersion="30" />
    <uses-permission
        android:name="android.permission.BLUETOOTH_ADMIN"
        android:maxSdkVersion="30" />

    <!--
      A system requirement of BLE scanning before API 31, not a product choice (PRD_SCALE 16.1):
      without it the scan simply returns nothing on Android 11 and below. `maxSdkVersion="30"`
      keeps it off Android 12 and later, where `neverForLocation` above replaces it entirely.

      The permission is not the whole story on those releases: location must also be switched on
      at system level, which PRD_SCALE 16.1 and 18.5 require Mue to detect and explain rather
      than let the user read as an empty list of results.
    -->
    <uses-permission
        android:name="android.permission.ACCESS_FINE_LOCATION"
        android:maxSdkVersion="30" />

    <!--
      `ACCESS_BACKGROUND_LOCATION` is deliberately absent, and its absence is a decision rather
      than an oversight (PRD_SCALE 16.1). No scan ever happens outside the foreground:
      FR-SCALE-020 starts the search when `Entry` becomes visible and stops it when it does not,
      with no service and no scheduled work behind it.
    -->

    <!--
      Declaring a Bluetooth permission makes Google Play infer `android.hardware.bluetooth` as
      required and filter the app off devices without a radio. BR-SCALE-011 says the opposite —
      everything but the scale works without one — so the feature is declared optional here and
      its absence is handled at runtime like a radio that is switched off.
    -->
    <uses-feature
        android:name="android.hardware.bluetooth_le"
        android:required="false" />

    <!--
      `bluetooth_le` does not cover it on its own. `BLUETOOTH` and `BLUETOOTH_ADMIN` above imply
      `android.hardware.bluetooth` — a different feature — and opting out of the LE one leaves
      that implication standing, so Play would still have filtered the app off a radio-less
      device. Two features, two opt-outs; BR-SCALE-011 needs both.
    -->
    <uses-feature
        android:name="android.hardware.bluetooth"
        android:required="false" />

    <!--
      FR-FOOD-003's barcode scanner (PRD_FOOD 9.2 and 18).

      Asked for at runtime, once, in the context of opening the scan path, and refused without
      consequence: PRD_FOOD 18 makes the manual barcode field "une alternative complète à la
      caméra", so a refusal lands on that field with an explanation and the lookup works exactly
      as well from it. Nothing else in the app opens a camera.
    -->
    <uses-permission android:name="android.permission.CAMERA" />

    <!--
      `required="false"`, deliberately. A device with no camera at all installs Mue and uses every
      other path, including the typed barcode; declaring the feature as required would remove the
      app from those devices to protect one of four ways of adding a line.
    -->
    <uses-feature android:name="android.hardware.camera.any" android:required="false" />

    <application
        android:name=".MueApplication"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Mue">

        <!--
          Portrait is a product decision, not an oversight: PRD 20.1 fixes the orientation and
          PRD 5 puts landscape and tablet outside the V1. The scale is a horizontal gesture
          sized against the screen width, so a landscape layout is a redesign, not a rotation.
        -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:screenOrientation="portrait"
            android:configChanges="uiMode|screenSize|smallestScreenSize|screenLayout|density|keyboardHidden|orientation"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/Theme.Mue"
            tools:ignore="DiscouragedApi,LockedOrientationActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
          `Pause`, `Resume` and `Discard` from the ongoing notification. Not exported: the only
          sender is this process, through its own PendingIntents, and nothing outside Mue has
          any business stopping a user's timer.
        -->
        <receiver
            android:name=".timer.TimerActionReceiver"
            android:directBootAware="false"
            android:exported="false" />

        <!--
          Reposts the notification of a timer that survived a reboot.

          `exported="true"` is mandatory and not a relaxation: a receiver that is not exported
          never receives a broadcast sent by the system, and it fails silently. BOOT_COMPLETED
          is a protected broadcast, so only the system can send it.

          `directBootAware="false"`, with no LOCKED_BOOT_COMPLETED filter: the database is
          credential-encrypted and cannot be read before the first unlock, which is exactly
          when the plain BOOT_COMPLETED broadcast arrives.
        -->
        <receiver
            android:name=".timer.BootCompletedReceiver"
            android:directBootAware="false"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

        <!--
          ML Kit's telemetry uploader, removed.

          `com.google.mlkit:barcode-scanning` transitively brings
          `com.google.android.datatransport:transport-backend-cct`, and ML Kit's own classes hold
          a `TransportFactory` aimed at `CCTDestination` under the log source `FIREBASE_ML_SDK`.
          Google documents what that sends — "device information (such as manufacturer, model, OS
          version and build)", "package name and app versions", "device identifier used for
          diagnostics and usage analytics", latency and error codes — and documents **no opt-out**
          (https://developers.google.com/ml-kit/android-data-disclosure).

          PRD_FOOD 9.2 and 22 promise that a scan sends the number and nothing else, and
          PRD_SERVER_SYNC_MCP 16 keeps this app's traffic to the server its owner paired with. A
          library that posts the phone's model to a third party the moment the scanner opens
          breaks both, and it does so on a path the person cannot see.

          The three components below are how `TransportRuntime` finds a backend for the name
          `cct` and how it schedules the upload. Removing them leaves every class present — so no
          `NoClassDefFoundError`, and ML Kit's logging calls still succeed — while the events they
          would have carried reach no network: backend resolution happens on the uploader's own
          background thread and its failure is logged, never thrown. **Decoding is unaffected, and
          that is asserted rather than assumed**: `MlKitBarcodeDecoderTest` decodes a real EAN-13
          on a device built from this manifest.

          `tools:node="remove"` and not a Gradle `exclude`: the classes have to stay, because they
          are what ML Kit calls into. Only the registration goes.
        -->
        <service
            android:name="com.google.android.datatransport.runtime.backends.TransportBackendDiscovery"
            tools:node="remove" />
        <service
            android:name="com.google.android.datatransport.runtime.scheduling.jobscheduling.JobInfoSchedulerService"
            tools:node="remove" />
        <receiver
            android:name="com.google.android.datatransport.runtime.scheduling.jobscheduling.AlarmManagerSchedulerBroadcastReceiver"
            tools:node="remove" />

        <!-- Shares the generated CSV without exposing the app's private storage. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>

</manifest>
