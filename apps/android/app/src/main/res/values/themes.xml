<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      Bare host theme only. All visual styling lives in Compose (ui/theme).
      The window background matches the Compose canvas so no light flash occurs at launch.
    -->
    <style name="Theme.Mue" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/mue_canvas</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
    </style>
</resources>
