<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <!--
      Bare host theme only. All visual styling lives in Compose (ui/theme).
      The window background matches the Compose canvas so no light flash occurs at launch.
    -->
    <style name="Theme.Mue" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/mue_canvas</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
        <!-- Ignored on API 26, which has no light navigation bar to opt out of. -->
        <item name="android:windowLightNavigationBar" tools:targetApi="27">false</item>
    </style>
</resources>
