<?xml version="1.0" encoding="utf-8"?>
<!--
  The product canvas, flat: a gradient would band and muddy at launcher sizes.

  The fill is `@color/launcher_background` rather than a literal, and the colour is a `resValue`
  in `app/build.gradle.kts` rather than a `values/colors.xml`. It resolves to the canvas #101012
  for `release` and `local`, and to a different flat tone for `beta` and `debug`, which is what
  stops three installed applications from presenting one identical icon. The foreground pills and
  the monochrome layer are shared by all three on purpose: the shape is the product's, only the
  ground behind it says which build this is.
-->

<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <path
        android:fillColor="@color/launcher_background"
        android:pathData="M0,0h108v108h-108z" />
</vector>
