{
  "name": "@mue/platform",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "TanStack Start entry point delegating /api/*, /mcp and /health/* to Hono",
  "scripts": {
    "dev": "vp dev",
    "build": "vp build",
    "start": "bun run dist/server/main.js",
    "typecheck": "tsc -p tsconfig.json",
    "test": "bun --env-file=../../.env test src",
    "lint": "vp lint src",
    "format": "vp fmt src",
    "format:check": "vp fmt --check src"
  },
  "dependencies": {
    "@mue/api": "workspace:*",
    "@mue/auth": "workspace:*",
    "@mue/contracts": "workspace:*",
    "@mue/db": "workspace:*",
    "@tanstack/react-router": "1.170.32",
    "@tanstack/react-start": "catalog:",
    "hono": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:"
  },
  "devDependencies": {
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:"
  }
}
